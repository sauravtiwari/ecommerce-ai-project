# Copy this file to `.env`, then fill in your real values.
#
#   .env.example  IS committed to git -- it documents what the app needs.
#   .env          is NOT committed    -- it holds the actual secrets.
#
# That pair is the whole convention. Anyone cloning the repo can see which
# variables to set without a password ever reaching GitHub.

ENVIRONMENT=development

# PostgreSQL connection string.
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD_HERE@localhost:5432/ecommerce
