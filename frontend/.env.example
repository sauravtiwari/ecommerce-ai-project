# Copy to `.env.local` for development. Next.js loads `.env.local`
# automatically and it is gitignored.
#
# In production this is NOT read from a file -- you set it in the Vercel
# dashboard under Settings -> Environment Variables.

# Base URL of the FastAPI backend.
# Local:      http://127.0.0.1:8000
# Production: https://your-service.onrender.com   (no trailing slash)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
